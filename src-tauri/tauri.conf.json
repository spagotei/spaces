{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spaces",
  "version": "0.0.23",
  "identifier": "com.spagotei.spaces",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spaces",
        "width": 1380,
        "height": 860,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RTk3QkU4QTY5OTM3MkUKUldRdU41bW02SHZwcUJkV0xiTmp2UFNxajhSWW1PeEY4L0ZrSnBQVk84Qi81cDhMenRxc3M3QnMK",
      "endpoints": [
        "https://spaces.spagotei.workers.dev/v1/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
